# ==================================
# Application Environment
# ==================================

# Application environment: development, staging, production
# This determines which features are enabled and how the app behaves
APP_ENV=development

# ==================================
# Server Configuration
# ==================================

# JWT Secret for authentication tokens - MUST be changed in production!
# Generate secure secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-min-32-chars-CHANGE-THIS-IN-PRODUCTION

# Debug mode (true for development, false for production)
# Automatically set based on APP_ENV if not specified
DEBUG=False

# Allowed hosts (comma separated). Reserved for future Host-header validation;
# NOT used for CORS (see CORS_ALLOWED_ORIGINS) or reverse proxy trust (see TRUSTED_PROXIES).
ALLOWED_HOSTS=0.0.0.0

# CORS allowed origins (comma separated, full URL with scheme, no wildcard).
# Required in production. Defaults to common localhost dev origins when unset in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Trusted reverse proxy IPs/CIDRs (comma separated) for parsing X-Forwarded-For.
# Not related to CORS. Defaults to loopback only in development; empty (trust none) elsewhere.
TRUSTED_PROXIES=127.0.0.1,::1

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Server timezone (IANA name, e.g. UTC, Asia/Jakarta). Default in code: UTC if unset.
SERVER_TIMEZONE=UTC

# Request read/write timeout in seconds (default 30). Used by http.Server.
REQUEST_TIMEOUT_SECONDS=30

# Graceful shutdown timeout in seconds (default 10). Max wait for in-flight requests.
SERVER_SHUTDOWN_TIMEOUT=10

# Refresh token lifetime in days (default 7). Tokens are hashed at rest and
# rotated on every use; expired or already-rotated tokens are rejected.
REFRESH_TOKEN_TTL_DAYS=7

# Access token (JWT) lifetime in minutes (default 15). Kept short because access
# tokens are stateless and cannot be revoked: logout/logout-all only revoke refresh
# tokens, so this TTL bounds how long an already-issued access token keeps working
# after the user logs out.
ACCESS_TOKEN_TTL_MINUTES=15

# Rate limit for auth routes: requests per second and burst size. Defaults: 100, 200.
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
# If true, use user_id from context (set by AuthMiddleware) for rate limit key on protected routes; else per IP.
RATE_LIMIT_USE_USER=False

# ==================================
# Database Configuration - Master
# ==================================

MASTER_DB_NAME=your_database_name
MASTER_DB_USER=your_database_user
MASTER_DB_PASSWORD=your_database_password
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_LOG_MODE=True
MASTER_SSL_MODE=disable

# ==================================
# Database Configuration - Replica (Read-Only)
# ==================================
# For read scaling. Can be same as master in development.

REPLICA_DB_NAME=your_database_name
REPLICA_DB_USER=your_database_user
REPLICA_DB_PASSWORD=your_database_password
REPLICA_DB_HOST=localhost
REPLICA_DB_PORT=5432
REPLICA_SSL_MODE=disable